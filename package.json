{
  "name": "storybook-react-starter",
  "version": "0.0.0",
  "description": "Minimal starter package to build a React based UI component library. Uses storybook and Typescript.",
  "repository": {
    "type": "git",
    "url": "git@github.com:boilerplatedev/storybook-react-starter.git"
  },
  "author": "Abhishek Bhardwaj <abhishek66ster@gmail.com>",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "types": "./dist/esm/index.d.ts",
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js",
    "default": "./dist/esm/index.js"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "dev:commit": "cz",
    "dev:open-bundle-visualizer": "open rollup-plugin-visualizer-stats.html",
    "test:coverage": "yarpm test --coverage",
    "test:debug": "yarpm test --debug --detectOpenHandles",
    "test:ci": "yarpm test --runInBand --no-cache --ci",
    "test": "NODE_ENV=test jest",
    "build": "yarpm clean && rollup -c --bundleConfigAsCjs",
    "publish-lib": "yarpm run build && yarpm publish",
    "publish-beta": "yarpm run build && yarpm publish --tag beta",
    "publish-dryrun": "yarpm run build && yarpm publish --dry-run",
    "dev": "yarpm run storybook:dev",
    "storybook:dev": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "storybook:build:run": "http-server ./storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "clean": "rimraf dist rollup-plugin-visualizer-stats.html",
    "reset": "yarpm clean && git clean -xdf node_modules",
    "lint": "eslint './{src,test}/**/*' --ext .js,.jsx,.tsx,.ts,.md",
    "format": "eslint './{src,test}/**/*' --ext .js,.jsx,.tsx,.ts,.md --fix",
    "update-all-dependencies": "npx --yes npm-check-updates -u",
    "prepare": "is-ci || husky"
  },
  "peerDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.13",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.7"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-big-lib": "^11.1.4",
    "@storybook/addon-a11y": "^8.2.6",
    "@storybook/addon-essentials": "^8.2.6",
    "@storybook/addon-interactions": "^8.2.6",
    "@storybook/addon-links": "^8.2.6",
    "@storybook/addon-mdx-gfm": "^8.2.6",
    "@storybook/addon-themes": "^8.2.6",
    "@storybook/blocks": "^8.2.6",
    "@storybook/manager-api": "^8.2.6",
    "@storybook/preview-api": "^8.2.6",
    "@storybook/react": "^8.2.6",
    "@storybook/react-vite": "^8.2.6",
    "@storybook/test": "^8.2.6",
    "@storybook/test-runner": "^0.19.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.2",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "commitizen": "^4.3.0",
    "cssnano": "^7.0.4",
    "cz-conventional-changelog": "3.3.0",
    "devmoji": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.8.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.4",
    "is-ci": "^3.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.7",
    "open": "^10.1.0",
    "postcss": "^8.4.40",
    "postcss-import": "^16.1.0",
    "prettier": "^3.3.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.19.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "semantic-release": "^24.0.0",
    "size-limit": "^11.1.4",
    "storybook": "^8.2.6",
    "tailwindcss": "^3.4.7",
    "ts-jest": "^29.2.3",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.5",
    "yarpm": "^1.2.0"
  },
  "size-limit": [
    {
      "path": "dist/*.js"
    }
  ],
  "packageManager": "pnpm@9.6.0+sha512.38dc6fba8dba35b39340b9700112c2fe1e12f10b17134715a4aa98ccf7bb035e76fd981cf0bb384dfa98f8d6af5481c2bef2f4266a24bfa20c34eb7147ce0b5e"
}
